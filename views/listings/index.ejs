<% layout("/layouts/boilerplate.ejs") -%>

<body>
    <h3>All listings</h3>
    <!--<form method="GET" action="/listing/new">
        <button>ADD NEW LISTING</button>
    </form> -->

   <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
    <% for(let listing of allListings) { %>
    <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card listing-card">
                <img src="<%=listing.image%>" class="card-img-top" alt="listing_image" />
                <div class="card-body">
                    <p class="card-text">
                        <span class="listing-title"><%= listing.title %></span> <br />
                        <span class="listing-price">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> 
                        <span class="per-night">/ night</span>
                    </p>
                </div>
            </div>
        </a>
    </div>
    <% } %>
</div>
   
    
</body>
