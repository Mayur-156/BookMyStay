<% layout("/layouts/boilerplate.ejs") -%>

<div class="container show-page">

  <!-- Title + Edit -->
  <div class="d-flex justify-content-between align-items-end mb-3">
    <div>
      <h2 class="show-title"><%= listing.title %></h2>
      <p class="location-text mb-0">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>
    </div>

    <a href="/listings/<%= listing._id %>/edit" class="edit-link">
      <i class="fa-solid fa-pen-to-square"></i> Edit
    </a>
  </div>

  <!-- ✅ CLEAR IMAGE SECTION -->
  <div class="show-image-wrapper">
    <img
      src="<%= listing.image %>"
      alt="listing image"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="row mt-4">

    <!-- LEFT CONTENT -->
    <div class="col-lg-8">
      <div class="details-card">
        <h5 class="section-label">About this place</h5>
        <p class="description-text"><%= listing.description %></p>
      </div>
    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="col-lg-4">
      <div class="action-card shadow-sm">

        <h3 class="price-big">
          ₹ <%= listing.price.toLocaleString("en-IN") %>
          <span class="per-night">/ night</span>
        </h3>

        <div class="action-buttons mt-4 d-flex flex-column gap-2">

          <a href="/listings/<%= listing._id %>/edit"
             class="btn-edit-main text-center">
            Edit Listing
          </a>

          <form method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn-delete-outline w-100">
              <i class="fa-regular fa-trash-can"></i> Delete Listing
            </button>
          </form>

        </div>

        <p class="text-muted text-center small mt-3 mb-0">
          Only you can see these management tools
        </p>

      </div>
    </div>

  </div>
</div>
