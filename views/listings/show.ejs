<% layout("/layouts/boilerplate.ejs") -%>

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12 mb-3 d-flex justify-content-between align-items-end">
            <div>
                <h2 class="show-title mb-0"><%= listing.title %></h2>
            </div>
            <a href="/listings/<%=listing._id %>/edit" class="text-dark text-decoration-underline fw-bold small">
                <i class="fa-solid fa-pen-to-square"></i> Edit Listing
            </a>
        </div>

        <div class="col-12 mb-4 show-img">
            <img src="<%= listing.image %>" class="show-img shadow-sm" alt="listing_image" />
        </div>

        <div class="col-lg-8 col-md-12">
            <div class="details-content">
                <p class="location-text">
                    <i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %>
                </p>
                <hr />
                <h5 class="section-label">About this place</h5>
                <p class="description-text"><%= listing.description %></p>
                <hr />
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="action-card shadow-sm border p-4 rounded-4 sticky-top" style="top: 100px; z-index: 1;">
                <h3 class="price-big">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="per-night">/ night</span></h3>
                
                <div class="action-buttons mt-4 d-flex flex-column gap-2">
                    

                    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                        <button class="btn btn-delete-outline w-100">
                           <i class="fa-regular fa-trash-can"></i> Delete Listing
                        </button>
                    </form>
                </div>
                
                <p class="text-center text-muted mt-3 mb-0 small">Only you can see these management tools.</p>
            </div>
        </div>
    </div>
</div>